# 이 파일을 복사해서 .env 로 만들고 값을 채우세요:  cp .env.example .env
# .env 는 .gitignore 에 있어서 Git에 올라가지 않습니다. .env.example 에는 진짜 값을 넣지 마세요.

# GitHub Fine-grained PAT (Public repositories 읽기 전용, 추가 권한 없음)
GITHUB_TOKEN=

# PostgreSQL (docker-compose 단계에서 사용)
POSTGRES_USER=oss
POSTGRES_PASSWORD=change-me
POSTGRES_DB=oss_closeup
